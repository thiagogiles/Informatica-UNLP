programa p4ej3
procesos
  proceso jp
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
  fin
areas
  aj: AreaP(10,1,10,1)
  a1: AreaP(1,1,1,100)
  a2: AreaP(2,1,2,100)
  a3: AreaP(3,1,3,100)
robots
  robot p1
  variables
    id,aux:numero
  comenzar
    RecibirMensaje(id,j)
    repetir 19
      repetir 5
        jp
        mover
      jp
      EnviarMensaje(1,r2)
      EnviarMensaje(1,r3)
      repetir 2
        RecibirMensaje(aux,*)
    repetir 4
      jp
      mover
    jp
  fin
  robot p2
  variables
    id,aux:numero
  comenzar
    RecibirMensaje(id,j)
    repetir 19
      repetir 5
        jp
        mover
      jp
      EnviarMensaje(1,r1)
      EnviarMensaje(1,r3)
      repetir 2
        RecibirMensaje(aux,*)
    repetir 4
      jp
      mover
    jp
  fin
  robot p3
  variables
    id,aux:numero
  comenzar
    RecibirMensaje(id,j)
    repetir 19
      repetir 5
        jp
        mover
      jp
      EnviarMensaje(1,r2)
      EnviarMensaje(1,r1)
      repetir 2
        RecibirMensaje(aux,*)
    repetir 4
      jp
      mover
    jp
  fin
  robot juez
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
variables
  r1:p1
  r2:p2
  r3:p3
  j:juez
comenzar
  AsignarArea(r1,a1)
  AsignarArea(r2,a2)
  AsignarArea(r3,a3)
  AsignarArea(j,aj)
  Iniciar(j,10,1)
  Iniciar(r1,1,1)
  Iniciar(r2,2,1)
  Iniciar(r3,3,1)
fin

// Cuando hay uno que va mas lentos que los otros por algun motivo termina el program4, no termina de caminar y juntar, lo probe tres veces y solo paso una 