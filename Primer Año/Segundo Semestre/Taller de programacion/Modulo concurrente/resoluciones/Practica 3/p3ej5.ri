programa p3ej5
procesos
  proceso com
  variables
    sigo:boolean
    avx,cax:numero
  comenzar
    sigo:=V
    mientras((sigo) & (PosCa<100))
      avx:=PosAv
      cax:=PosCa
      BloquearEsquina(11,11)
      Pos(11,11)
      si(HayPapelEnLaEsquina)
        tomarPapel
        Pos(avx,cax)
        LiberarEsquina(11,11)
        depositarPapel
        mover
      sino
        sigo:=F
        Pos(avx,cax)
        LiberarEsquina(11,11)
  fin
areas
  fuente: AreaPC (11,11,11,11)
  aj: AreaP(1,1,1,1)
  a1: AreaP(4,1,4,100)
  a2: AreaP(6,1,6,100)
  a3: AreaP(8,1,8,100)
  a4: AreaP(10,1,10,100)
robots
  robot competidor
  variables
    id,cax:numero
  comenzar
    RecibirMensaje(id,rj)
    com
    EnviarMensaje(id,rj)
    cax:=PosCa
    EnviarMensaje(cax,rj)
  fin
  robot juez
  variables
    id,max,ganador,aux:numero
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
    max:=-1
    repetir 4
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(aux,r1)
        si(aux>max)
          max:=aux
          ganador:=id
      sino
        si(id=2)
          RecibirMensaje(aux,r2)
          si(aux>max)
            max:=aux
            ganador:=id
        sino
          si(id=3)
            RecibirMensaje(aux,r3)
            si(aux>max)
              max:=aux
              ganador:=id
          sino
            RecibirMensaje(aux,r4)
            si(aux>max)
              max:=aux
              ganador:=id
    Informar("el ganador es", ganador)
  fin
  
variables
  r1,r2,r3,r4: competidor
  rj:juez
comenzar
  AsignarArea(r1,fuente)
  AsignarArea(r2,fuente)
  AsignarArea(r3,fuente)
  AsignarArea(r4,fuente)
  AsignarArea(r1,a1)
  AsignarArea(r2,a2)
  AsignarArea(r3,a3)
  AsignarArea(r4,a4)
  AsignarArea(rj,aj)
  Iniciar(rj,1,1)
  Iniciar(r1,4,1)
  Iniciar(r2,6,1)
  Iniciar(r3,8,1)
  Iniciar(r4,10,1)
fin