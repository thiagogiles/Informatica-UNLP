programa ej3

areas
  cuadrante: AreaPC (2,2,10,10)
  aj: AreaP(1,1,1,1)
  a2: AreaP(2,1,2,1)
  a3: AreaP(3,1,3,1)
  a4: AreaP(4,1,4,1)
  a5: AreaP(5,1,5,1)
robots
  robot competidor
  variables
    id,fl,auxav,auxca,av,ca:numero
    ok:boolean
  comenzar
    RecibirMensaje(id,rj)
    ok:=V
    fl:=0
    auxav:=PosAv
    auxca:=PosCa
    RecibirMensaje(av,rj)
    RecibirMensaje(ca,rj)
    mientras(ok)
      BloquearEsquina(av,ca)
      Pos(av,ca)
      si(HayFlorEnLaEsquina)
        tomarFlor
        fl:=fl+1
      sino
        ok:=F
      Pos(auxav,auxca)
      LiberarEsquina(av,ca)
    EnviarMensaje(id,rj)
    EnviarMensaje(fl,rj)
  fin
  robot juez
  variables
    id,ganador,max,fl,avran,caran:numero
  comenzar
    max:=0
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
    Random(avran,2,10)
    Random(caran,2,10)
    EnviarMensaje(avran,r1)
    EnviarMensaje(caran,r1)
    EnviarMensaje(avran,r2)
    EnviarMensaje(caran,r2)
    EnviarMensaje(avran,r3)
    EnviarMensaje(caran,r3)
    EnviarMensaje(avran,r4)
    EnviarMensaje(caran,r4)
    repetir 4
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(fl,r1)
        si(fl>max)
          max:=fl
          ganador:=id
      sino
        si(id=2)
          RecibirMensaje(fl,r2)
          si(fl>max)
            max:=fl
            ganador:=id
        sino
          si(id=3)
            RecibirMensaje(fl,r3)
            si(fl>max)
              max:=fl
              ganador:=id
          sino
            RecibirMensaje(fl,r4)
            si(fl>max)
              max:=fl
              ganador:=id
    Informar("el ganador es",ganador)
  fin
variables
  r1,r2,r3,r4: competidor
  rj:juez
comenzar
  AsignarArea(rj, aj)
  AsignarArea(r1, a2)
  AsignarArea(r2, a3)
  AsignarArea(r3, a4)
  AsignarArea(r4, a5)
  AsignarArea(r1, cuadrante)
  AsignarArea(r2, cuadrante)
  AsignarArea(r3, cuadrante)
  AsignarArea(r4, cuadrante)
  Iniciar(rj, 1,1)
  Iniciar(r1,2,1)
  Iniciar(r2,3,1)
  Iniciar(r3,4,1)
  Iniciar(r4,5,1)
fin






/////////////////////// VERSION CON MODULOS ///////////////

programa ej3
procesos 
  proceso enviarID
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
  fin
  proceso enviarCalle
  variables
    avran,caran:numero
  comenzar
    Random(avran,2,10)
    Random(caran,2,10)
    EnviarMensaje(avran,r1)
    EnviarMensaje(caran,r1)
    EnviarMensaje(avran,r2)
    EnviarMensaje(caran,r2)
    EnviarMensaje(avran,r3)
    EnviarMensaje(caran,r3)
    EnviarMensaje(avran,r4)
    EnviarMensaje(caran,r4)
  fin
  proceso ganador(ES ganador:numero ES max:numero)
  variables
    fl,id:numero
  comenzar
    RecibirMensaje(id,*)
    si(id=1)
      RecibirMensaje(fl,r1)
      si(fl>max)
        max:=fl
        ganador:=id
    sino
      si(id=2)
        RecibirMensaje(fl,r2)
        si(fl>max)
          max:=fl
          ganador:=id
      sino
        si(id=3)
          RecibirMensaje(fl,r3)
          si(fl>max)
            max:=fl
            ganador:=id
        sino
          RecibirMensaje(fl,r4)
          si(fl>max)
            max:=fl
            ganador:=id
  fin
areas
  cuadrante: AreaPC (2,2,10,10)
  aj: AreaP(1,1,1,1)
  a2: AreaP(2,1,2,1)
  a3: AreaP(3,1,3,1)
  a4: AreaP(4,1,4,1)
  a5: AreaP(5,1,5,1)
robots
  robot competidor
  variables
    id,fl,auxav,auxca,av,ca:numero
    ok:boolean
  comenzar
    RecibirMensaje(id,rj)
    ok:=V
    fl:=0
    auxav:=PosAv
    auxca:=PosCa
    RecibirMensaje(av,rj)
    RecibirMensaje(ca,rj)
    mientras(ok)
      BloquearEsquina(av,ca)
      Pos(av,ca)
      si(HayFlorEnLaEsquina)
        tomarFlor
        fl:=fl+1
      sino
        ok:=F
      Pos(auxav,auxca)
      LiberarEsquina(av,ca)
    EnviarMensaje(id,rj)
    EnviarMensaje(fl,rj)
  fin
  robot juez
  variables
    id,ganador,max:numero
  comenzar
    max:=0
    enviarID
    enviarCalle
    repetir 4
      ganador(ganador,max)
    Informar("el ganador es",ganador)
  fin
variables
  r1,r2,r3,r4: competidor
  rj:juez
comenzar
  AsignarArea(rj, aj)
  AsignarArea(r1, a2)
  AsignarArea(r2, a3)
  AsignarArea(r3, a4)
  AsignarArea(r4, a5)
  AsignarArea(r1, cuadrante)
  AsignarArea(r2, cuadrante)
  AsignarArea(r3, cuadrante)
  AsignarArea(r4, cuadrante)
  Iniciar(rj, 1,1)
  Iniciar(r1,2,1)
  Iniciar(r2,3,1)
  Iniciar(r3,4,1)
  Iniciar(r4,5,1)
fin