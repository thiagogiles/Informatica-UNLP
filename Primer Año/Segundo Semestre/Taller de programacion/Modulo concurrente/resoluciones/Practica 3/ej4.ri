programa ejm
procesos
  proceso trabajo
  variables
    avx,cax:numero
    ok:boolean
  comenzar
    ok:=V
    avx:=PosAv
    cax:=PosCa
    mientras(ok)
      BloquearEsquina(10,10)
      Pos(10,10)
      si(HayFlorEnLaEsquina)
        tomarFlor
        BloquearEsquina(11,11)
        Pos(11,11)
        LiberarEsquina(10,10)
        depositarFlor
        Pos(avx,cax)
        LiberarEsquina(11,11)
      sino
        ok:=F
        Pos(avx,cax)
        LiberarEsquina(10,10)
  fin
  proceso limpiar
  comenzar
    Pos(11,11)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
    Pos(1,1)
  fin
areas
  p1: AreaPC(10,10,10,10)
  p2: AreaPC(11,11,11,11)
  aj: AreaP(1,1,1,1)
  a1: AreaP(9,9,9,9)
  a2: AreaP(9,10,9,10)
  a3: AreaP(9,11,9,11)
  a4: AreaP(9,12,9,12)
robots
  robot peon
  variables
    id:numero
  comenzar
    RecibirMensaje(id,rj)
    trabajo
    EnviarMensaje(id,rj)
  fin
  robot juez
  variables
    id:numero
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
    repetir 4
      RecibirMensaje(id,*)
    Informar("el ultimo en llegar fue",id)
    limpiar
  fin
variables
  r1,r2,r3,r4: peon
  rj:juez
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r2, a2)
  AsignarArea(r3, a3)
  AsignarArea(r4, a4)
  AsignarArea(rj, aj)
  AsignarArea(r1, p1)
  AsignarArea(r2, p1)
  AsignarArea(r3, p1)
  AsignarArea(r4, p1)
  AsignarArea(r1, p2)
  AsignarArea(r2, p2)
  AsignarArea(r3, p2)
  AsignarArea(r4, p2)
  AsignarArea(rj, p2)
  Iniciar(rj, 1,1)
  Iniciar(r1, 9,9)
  Iniciar(r2, 9,10)
  Iniciar(r3, 9,11)
  Iniciar(r4, 9,12)
fin