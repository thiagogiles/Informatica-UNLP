programa p2ej1B
procesos
  proceso jf(ES flo:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flo:=flo + 1
  fin
  proceso moverseA(ES flo:numero)
  comenzar
    repetir 99
      jf(flo)
      mover
    jf(flo)
  fin
  proceso moverseB(ES flo:numero)
  comenzar
    repetir 98
      jf(flo)
      mover
    jf(flo)
  fin
  proceso recorrerA(ES flo:numero)
  comenzar
    repetir 9
      moverseA(flo)
      Pos(1,PosCa+1)
    moverseA(flo)
  fin
  proceso recorrerB(ES flo:numero)
  comenzar
    repetir 9
      moverseB(flo)
      Pos(2,PosCa+1)
    moverseB(flo)
  fin
areas
  a1: AreaP (1,1,100,10)
  a2: AreaP (2,11,100,20)
  a3: AreaP (50,50,50,50)
robots
  robot robot1
  variables
    flo:numero
    ok:boolean
  comenzar
    flo:=0
    derecha
    recorrerA(flo)
    EnviarMensaje(flo,r3)
    RecibirMensaje(ok,r3)
    si(ok = V)
      RecibirMensaje(flo,r3)
      Informar("La diferencia es de",flo)
  fin
  robot robot2
  variables
    flo:numero
    ok:boolean
  comenzar
    flo:=0
    derecha
    recorrerB(flo)
    EnviarMensaje(flo,r3)
    RecibirMensaje(ok,r3)
    si(ok = V)
      RecibirMensaje(flo,r3)
      Informar("La diferencia es de",flo)
  fin
  robot fiscal
  variables
    f1,f2,resta:numero
  comenzar
    RecibirMensaje(f1,r1)
    RecibirMensaje(f2,r2)
    si(f1 > f2)
      EnviarMensaje(F,r2)
      EnviarMensaje(V,r1)
      resta:= f1 - f2
      EnviarMensaje(resta,r1)
    sino
      EnviarMensaje(F,r1)
      EnviarMensaje(V,r2)
      resta:=f2 - f1
      EnviarMensaje(resta,r2)
  fin
variables
  r1: robot1
  r2: robot2
  r3: fiscal
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r2,a2)
  AsignarArea(r3,a3)
  Iniciar(r1, 1,1)
  Iniciar(r2,2,11)
  Iniciar(r3,50,50)
fin